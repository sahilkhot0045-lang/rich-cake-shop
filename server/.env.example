# Rich Cake Shop Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# If empty or unreachable, server gracefully spins up an in-memory replica set for zero-friction local development & testing
MONGODB_URI=mongodb://127.0.0.1:27017/rich_cake_shop

# Authentication Secrets
JWT_SECRET=super_secret_rich_cake_shop_jwt_token_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Razorpay Test Credentials (Get yours from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_RichCakeShopTestKey
RAZORPAY_KEY_SECRET=RichCakeShopTestSecretKey12345
RAZORPAY_WEBHOOK_SECRET=RichCakeShopWebhookSecret12345

# Admin Bootstrap Credentials (Used during initial seed)
ADMIN_NAME=Rich Cake Admin
ADMIN_EMAIL=admin@richcakeshop.com
ADMIN_PASSWORD=RichCake@Admin2026
ADMIN_PHONE=+919820098200
